{
  "pool": {
    "encoder": "pool",
    "embedding": "fasttext",
    "filter": "no-stopwords-but-sentiment",
    "pooling": "mean",
    "init": "pretrained",
    "train_embeddings": true,
    "hidden": [
      50,
      50
    ],
    "dropout": 0.1,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "max_epochs": 30,
    "patience": 3
  },
  "rnn": {
    "encoder": "gru",
    "embedding": "fasttext",
    "filter": "all",
    "init": "pretrained",
    "train_embeddings": false,
    "hidden_size": 128,
    "bidirectional": false,
    "readout": "max",
    "word_dropout": 0.1,
    "max_len": 400,
    "truncation": "head",
    "hidden": [
      50,
      50
    ],
    "dropout": 0.1,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "max_epochs": 20,
    "patience": 3,
    "clip": 1.0
  }
}